# Copy this file to .env.local and fill in the values from your Supabase project
# (Dashboard → Project Settings → API).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Optional. Base URL encoded into the join QR code so phones don't get
# "localhost". Set to the LAN/tunnel/deployed address phones can reach,
# e.g. http://192.168.0.10:5173. If empty, the page's own origin is used.
VITE_PUBLIC_BASE_URL=
